# Operator-private overrides for the Makefile and deploy targets.
# Copy to `.env` (gitignored) and fill in your values; `make` auto-sources it.
#
# All variables are optional — the Makefile defaults to placeholder values.
# Set what you need for your environment.

# --- Container image ---
# Where `make docker-push` will push the built image.
IMAGE_REPO=registry.example.com/library/honkai-rule-server

# Override the tag (defaults to git short SHA of HEAD).
# IMAGE_TAG=

# --- Kubernetes deploy targets (config-sync, rules-sync, pod-restart, cache-clear) ---
# kubectl context name for your cluster (matches `kubectl config get-contexts`).
KUBE_CONTEXT=

# Namespace where the chart is installed.
NAMESPACE=

# Helm release name. Resources rendered as <release>, <release>-config, <release>-data.
DEPLOYMENT_NAME=honkai-rule-server
CONFIG_MAP_NAME=honkai-rule-server-config

# --- Public-facing URL (only used by helper scripts / docs) ---
# Public host where the Ingress terminates TLS for this service.
PUBLIC_HOST=example.com

# Random 32-char lowercase hex used as the Ingress path prefix (see specs/009).
PATH_PREFIX=
